# Optional CLI model defaults. Never commit real keys.
VALUATION_LLM_PROVIDER=openai_compatible
VALUATION_LLM_BASE_URL=https://api.openai.com/v1
VALUATION_LLM_MODEL=
VALUATION_LLM_API_KEY=
# auto: official DeepSeek uses non-thinking tool calls for compatibility.
# enabled: pass thinking history in memory and use automatic tool selection.
VALUATION_LLM_THINKING=auto
VALUATION_LLM_REASONING_PROTOCOL=auto
VALUATION_LLM_TEMPERATURE=0
VALUATION_LLM_TOP_P=
VALUATION_LLM_PRESENCE_PENALTY=
VALUATION_LLM_TOP_K=
VALUATION_LLM_TOOL_CALL_FORMAT=native
VALUATION_LLM_OUTPUT_TOKEN_BUDGET=8192
VALUATION_LLM_MAX_OUTPUT_TOKENS=16384
VALUATION_LLM_TIMEOUT_SECONDS=180

# Official A-share point-in-time statements, daily indicators and peer universe.
TUSHARE_TOKEN=
INFOWAY_API_KEY=

# Real web search. "auto" enables Tavily only when a key is present.
VALUATION_SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# Runtime storage and allowed browser origins.
VALUATION_DATA_DIR=./var
VALUATION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Blank: loopback-only. Set a unique random 32+ character token for protected single-operator access.
# This is NOT a model API key. Keep it in the process environment, never in source control.
VALUATION_ACCESS_TOKEN=
VALUATION_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
